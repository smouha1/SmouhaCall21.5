<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Architectural Scene Background (same as Picker Performance Glass V4!) -->
    <ImageView
        android:id="@+id/sceneBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_arch_v4" />

    <!-- Warm Frosted / Smoked Obsidian Scrim -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scene_scrim" />

    <!-- Main Foreground Shell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Glassy Topbar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_strong"
            android:elevation="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="11dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_brand_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/brandTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="@string/brand_tag"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="11dp"
                android:paddingVertical="5dp"
                android:text="@string/status_stopped"
                android:textColor="@color/success"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnThemeToggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card_inner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🌙"
                android:textColor="@color/text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Content Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ==================== PANEL 0: HOME OVERVIEW ==================== -->
            <ScrollView
                android:id="@+id/panelHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Device Banner Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeDeviceName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/homeSubtitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textColor="@color/muted"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="42dp"
                            android:paddingHorizontal="14dp"
                            android:text="@string/start_bridge"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3 KPI Cards Row (Picker Performance KPI Style with 4dp Accent Bar) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- KPI 1: Bridge Status -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="horizontal"
                            android:padding="11dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_accent_bar_green" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/card_bridge"
                                    android:textColor="@color/muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiBridge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Online"
                                    android:textColor="@color/success"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiBridgeSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0 PCs paired"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- KPI 2: Wi-Fi Network -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="5dp"
                            android:layout_weight="1.15"
                            android:background="@drawable/bg_card"
                            android:orientation="horizontal"
                            android:padding="11dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_accent_bar_orange" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/card_network"
                                    android:textColor="@color/muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiNetwork"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="monospace"
                                    android:text="—"
                                    android:textColor="@color/text"
                                    android:textSize="12.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiPortSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Port 8765 · Auto-IP"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- KPI 3: Today Volume (Calls & WhatsApp) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card"
                            android:orientation="horizontal"
                            android:padding="11dp">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_accent_bar_orange" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/card_today"
                                    android:textColor="@color/muted"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiTodayTotal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="0"
                                    android:textColor="@color/primary"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/kpiTodaySub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="0 Call · 0 WA"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Permissions Readiness Row -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermission"
                        style="@style/Widget.SmouhaCall.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/grant_call" />

                    <TextView
                        android:id="@+id/permReadyLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_status_pill"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="12dp"
                        android:text="@string/status_ready"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverlay"
                        style="@style/Widget.SmouhaCall.Button.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/grant_overlay" />

                    <!-- ==================== ZERO-IP FAST PAIRING CARD ==================== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/card_pair"
                                android:textColor="@color/text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/pairWindowBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_pill"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="⚡ AUTO-PAIR OPEN"
                                android:textColor="@color/success"
                                android:textSize="10.5sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pairHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/pair_hint"
                            android:textColor="@color/muted"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/brandAlways"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <!-- PRIMARY 1-TAP ZERO-IP PAIR BUTTON -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAcceptPcPair"
                            style="@style/Widget.SmouhaCall.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/accept_pc_pair"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <!-- Secondary Pair Actions: Scan PC QR + Show/Hide Manual Pair -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnScanPcQr"
                                style="@style/Widget.SmouhaCall.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="@string/scan_pc_qr"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTogglePair"
                                style="@style/Widget.SmouhaCall.Button.Outline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:text="@string/show_pair"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Expandable Visual QR + JSON Block -->
                        <LinearLayout
                            android:id="@+id/pairCodeBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card_inner"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/qrImageView"
                                android:layout_width="170dp"
                                android:layout_height="170dp"
                                android:layout_marginBottom="10dp"
                                android:background="#FFFFFF"
                                android:contentDescription="Pair QR Code"
                                android:padding="6dp" />

                            <TextView
                                android:id="@+id/payloadText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:padding="8dp"
                                android:textColor="@color/text"
                                android:textIsSelectable="true"
                                android:textSize="10.5sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRefreshQr"
                                    style="@style/Widget.SmouhaCall.Button.Outline"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="5dp"
                                    android:layout_weight="1"
                                    android:text="@string/refresh_qr"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopy"
                                    style="@style/Widget.SmouhaCall.Button.Outline"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:layout_weight="1"
                                    android:text="@string/copy_payload"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Latest Live Action Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/last_action"
                            android:textColor="@color/muted"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lastActionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="monospace"
                            android:text="@string/no_activity"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- ==================== PANEL 1: ACTIVITY LOG ==================== -->
            <ScrollView
                android:id="@+id/panelActivity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_strong"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/nav_activity"
                            android:textColor="@color/text"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearActivity"
                            style="@style/Widget.SmouhaCall.Button.Outline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:paddingHorizontal="12dp"
                            android:text="@string/clear_activity"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/activityList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/activityEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="@string/no_activity"
                        android:textColor="@color/muted" />
                </LinearLayout>
            </ScrollView>

            <!-- ==================== PANEL 2: SETTINGS ==================== -->
            <ScrollView
                android:id="@+id/panelSettings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/device_name_label"
                            android:textColor="@color/muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/editDeviceName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_card_inner"
                            android:hint="@string/default_phone_name"
                            android:inputType="text"
                            android:padding="12dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/muted"
                            android:textSize="15sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/save_name" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_start"
                            android:textColor="@color/text"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchAutoStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/batteryStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/battery_status_unknown"
                            android:textColor="@color/text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatteryOpt"
                            style="@style/Widget.SmouhaCall.Button.Outline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/battery_allow" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settingsMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_card"
                        android:fontFamily="monospace"
                        android:padding="14dp"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/nav_bg"
            android:elevation="8dp"
            app:itemIconTint="@color/primary"
            app:itemTextColor="@color/primary"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav" />
    </LinearLayout>
</FrameLayout>
